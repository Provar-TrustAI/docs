# Planning material under docs-plan/ — local to the docs repo, not part of the published site.
# Be specific so docs-plan/versioning/ and docs-plan/runbooks/ stay tracked as team contracts.
docs-plan/audit/
docs-plan/branding/
docs-plan/icons-and-style/
docs-plan/*.md

# gstack skill state directory
.gstack/

# Claude Code session state stays local — but agent profiles and skills are
# versioned team assets (the doc kit's operational half; see docs-plan/doc-kit/00-playbook.md)
.claude/*
!.claude/agents/
!.claude/skills/
.env

# Playwright capture scripts
captures/node_modules/

# Pipeline build artifacts
pipeline/node_modules/
pipeline/out/

# Playwright run artifacts
captures/test-results/

# Raw screen recordings handed over for demo editing. These can contain org
# hostnames, admin usernames, OAuth codes, and the presenter's webcam feed.
# They are reviewed and cut before anything derived from them is committed.
# The source never is.
pipeline/public/incoming/
