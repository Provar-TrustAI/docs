{
  "name": "trust-ai-docs",
  "private": true,
  "description": "Provar-TrustAI docs (Mintlify) — repo-level scripts that don't belong to captures/ or pipeline/.",
  "scripts": {
    "export:functional-bundle": "node scripts/export-functional-bundle.mjs",
    "test:functional-bundle": "node --test scripts/export-functional-bundle.test.mjs",
    "generate:reference": "python3 scripts/generate-reference.py",
    "test:reference": "python3 -m unittest discover -s scripts -p test_generate_reference.py"
  },
  "engines": {
    "node": ">=20"
  }
}
